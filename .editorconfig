root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{html,html.j2}]
indent_size = 2

[*.{js,mjs,ts,jsx,tsx,css,svg}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
